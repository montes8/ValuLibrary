<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PlayVale" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="SplashTheme" parent="Theme.PlayVale">
        <item name="android:windowBackground">@color/primary_Accent</item>
        <item name="android:windowSplashScreenBackground" tools:ignore="NewApi">@color/primary_Accent</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:ignore="NewApi">@drawable/logo_content</item>
    </style>

        <style name="Theme.PlayValeLight" parent="Theme.AppCompat.Light.NoActionBar">
            <item name="android:statusBarColor">@color/primary_secondary</item>
            <item name="android:windowLightStatusBar">true</item>
            <item name="android:windowContentTransitions">true</item>
            <item name="android:windowDisablePreview">true</item>

        </style>

</resources>